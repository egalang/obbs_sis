<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_rating_sheet_wizard_form" model="ir.ui.view">
            <field name="name">rating.sheet.wizard.form</field>
            <field name="model">sis.rating.sheet.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Rating Sheet">
                    <group>
                        <field name="school_year_id" required="1" />
                        <field name="section_id" required="1" />
                        <field name="period_id" required="1" />
                    </group>
                    <footer>
                        <button name="action_generate_rating_sheet"
                            type="object"
                            string="Generate Excel"
                            class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
