<odoo>
    <record id="view_generate_id_wizard_form" model="ir.ui.view">
        <field name="name">generate.id.wizard.form</field>
        <field name="model">sis.generate.id.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Student ID">
                <group>
                    <field name="enrollment_id" readonly="1" invisible="1" />
                    <field name="id_type" />
                </group>
                <footer>
                    <button name="action_generate_id" type="object" string="Generate ID"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_id_wizard" model="ir.actions.act_window">
        <field name="name">Generate Student ID</field>
        <field name="res_model">sis.generate.id.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_generate_id_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>