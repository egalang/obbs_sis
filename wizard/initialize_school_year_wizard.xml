<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_initialize_school_year_wizard_form" model="ir.ui.view">
        <field name="name">sis.initialize.school.year.wizard.form</field>
        <field name="model">sis.initialize.school.year.wizard</field>
        <field name="arch" type="xml">
            <form string="Initialize School Year">
                <sheet>
                    <group>
                        <group>
                            <field name="target_school_year_id" options="{'no_create': True}"/>
                            <field name="source_school_year_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="copy_sections"/>
                            <field name="copy_periods"/>
                            <field name="copy_tuitions"/>
                            <field name="clear_existing"/>
                            <field name="activate_after_init"/>
                        </group>
                    </group>
                    <group invisible="not result_message">
                        <field name="result_message" nolabel="1" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_initialize" type="object" string="Initialize" class="btn-primary" invisible="result_message"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_initialize_school_year_wizard" model="ir.actions.act_window">
        <field name="name">Initialize School Year</field>
        <field name="res_model">sis.initialize.school.year.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
