<odoo>
    <data>
        <record id="view_progress_report_wizard" model="ir.ui.view">
            <field name="name">Progress Report Wizard</field>
            <field name="model">sis.progress.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Progress Report">
                    <group>
                        <field name="school_year_id" />
                        <field name="channel_id" />
                        <field name="period_id" />
                    </group>
                    <footer>
                        <button name="generate_report" string="Generate Excel" type="object"
                            class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
