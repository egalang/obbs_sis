<odoo>
    <data>
        <!-- Record rule: portal users can only see their own enrollments -->
        <record id="rule_sis_enrollment_portal_own" model="ir.rule">
            <field name="name">Portal: Own Enrollments Only</field>
            <field name="model_id" ref="model_sis_enrollment" />
            <field name="groups" eval="[(4, ref('base.group_portal'))]" />
            <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
        </record>

        <record id="slide_channel_faculty_rule" model="ir.rule">
            <field name="name">Faculty: See only my subjects</field>
            <field name="model_id" ref="website_slides.model_slide_channel" />
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('obbs_sis.group_sis_faculty'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
        </record>

        <record id="slide_slide_faculty_access" model="ir.rule">
            <field name="name">Faculty: Access to Slide Content</field>
            <field name="model_id" ref="website_slides.model_slide_slide" />
            <field name="domain_force">[(1, '=', 1)]</field> <!-- allow all -->
            <field name="groups" eval="[(4, ref('obbs_sis.group_sis_faculty'))]" />
        </record>

    </data>
</odoo>