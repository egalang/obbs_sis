<odoo>
    <record id="paperformat_a4_landscape_custom" model="report.paperformat">
        <field name="name">A4 Landscape Half-Inch Margins</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12.7</field>
        <field name="margin_bottom">12.7</field>
        <field name="margin_left">12.7</field>
        <field name="margin_right">12.7</field>
    </record>

    <!-- DepEd Grade 1 Progress Report Card: 8.5 x 13 inch Long Bond, portrait -->
    <record id="paperformat_long_bond_portrait_custom" model="report.paperformat">
        <field name="name">Long Bond Portrait (8.5x13 inches)</field>
        <field name="default" eval="False" />
        <field name="format">custom</field>
        <field name="orientation">Portrait</field>
        <field name="page_width">216</field>
        <field name="page_height">330</field>
        <field name="margin_top">12.7</field>
        <field name="margin_bottom">12.7</field>
        <field name="margin_left">12.7</field>
        <field name="margin_right">12.7</field>
    </record>
</odoo>
  