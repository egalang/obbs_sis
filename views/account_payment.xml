<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_account_payment_form_inherit_enrollment" model="ir.ui.view">
            <field name="name">account.payment.form.inherit.enrollment</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="enrollment_id" readonly="1" options="{'no_open': True}" />
                    <field name="school_year_id" readonly="1" />
                </xpath>
            </field>
        </record>

        <record id="view_account_payment_tree_inherit_enrollment" model="ir.ui.view">
            <field name="name">account.payment.tree.inherit.enrollment</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="enrollment_id" readonly="1" optional="hide" />
                    <field name="school_year_id" readonly="1" optional="hide" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
