<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="sis_grade_level_list" model="ir.ui.view">
            <field name="name">Grade Level List</field>
            <field name="model">sis.grade.level</field>
            <field name="arch" type="xml">
                <list string="Grade Levels">
                    <field name="name" />
                    <field name="code" />
                    <field name="description" />
                    <field name="id_type" />
                    <field name="next_grade_level_id"/>
                </list>
            </field>
        </record>

        <record id="sis_grade_level_form" model="ir.ui.view">
            <field name="name">Grade Level Form</field>
            <field name="model">sis.grade.level</field>
            <field name="arch" type="xml">
                <form string="Grade Levels">
                    <sheet>
                        <group colspan="4">
                            <group>
                                <field name="name" />
                                <field name="next_grade_level_id"/>
                            </group>
                            <group>
                                <field name="code" />
                                <field name="id_type" />
                            </group>
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>