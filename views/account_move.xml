<odoo>
    <data>
        <record id="view_move_tree_inherit_enrollment" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.enrollment</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree" />
            <field name="arch" type="xml">
                <xpath expr="(//field[@name='invoice_partner_display_name'])[2]" position="after">
                    <field name="enrollment_id" readonly="1" optional="hide" invisible="not enrollment_id_visible" />
                    <field name="school_year_id" readonly="1" optional="hide" invisible="not enrollment_id_visible" />
                </xpath>
            </field>
        </record>

        <record id="view_move_form_inherit_enrollment" model="ir.ui.view">
            <field name="name">account.move.form.inherit.enrollment</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_shipping_id']" position="before">
                    <field name="enrollment_id" options="{'no_open': True}" invisible="not enrollment_id_visible" />
                    <field name="school_year_id" readonly="1" invisible="not enrollment_id_visible" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
