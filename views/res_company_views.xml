<odoo>
    <record id="view_company_form_inherit_school_setting" model="ir.ui.view">
        <field name="name">res.company.form.school.setting</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="before">
                <page string="School Setting" name="school_setting">
                    <group>
                        <group>
                            <field name="active_school_year_id" domain="[('company_id', '=', id)]"
                                options="{'no_create_edit': False}" help="Operational default school year for new SIS records." />
                        </group>
                        <group>
                            <field name="registrar_email" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
