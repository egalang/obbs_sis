<odoo>
    <record id="sis_grade_period_list" model="ir.ui.view">
        <field name="name">Grading Period List</field>
        <field name="model">sis.period</field>
        <field name="arch" type="xml">
            <list string="Grading Periods">
                <field name="school_year_id" />
                <field name="name" />
                <field name="code" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="description" optional="hide" />
            </list>
        </field>
    </record>

    <record id="sis_grade_period_form" model="ir.ui.view">
        <field name="name">Grading Period Form</field>
        <field name="model">sis.period</field>
        <field name="arch" type="xml">
            <form string="Grading Period">
                <sheet>
                    <group colspan="4">
                        <group>
                            <field name="school_year_id" />
                            <field name="name" />
                            <field name="start_date" />
                        </group>
                        <group>
                            <field name="code" />
                            <field name="end_date" />
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sis_grade_period_search" model="ir.ui.view">
        <field name="name">Grading Period Search</field>
        <field name="model">sis.period</field>
        <field name="arch" type="xml">
            <search string="Search Grading Periods">
                <field name="school_year_id" />
                <field name="name" />
                <field name="code" />
                <!-- <filter string="Current School Year" name="current_school_year"
                    domain="[('school_year_id', '=', user.company_id.active_school_year_id)]" /> -->
                <filter string="Current School Year"
                    name="current_school_year"
                    domain="[('school_year_id', '=', context.get('active_school_year_id'))]"/>
                <group expand="0" string="Group By">
                    <filter string="School Year" name="group_school_year" context="{'group_by': 'school_year_id'}" />
                </group>
            </search>
        </field>
    </record>
</odoo>
