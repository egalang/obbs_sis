<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <template id="website_enrollment_form" name="Enrollment Form">
      <t t-call="website.layout">
        <div class="container my-5">
          <h1 class="mb-4">Student Enrollment Form</h1>

          <!-- Custom Error Alert -->
          <t t-if="error">
            <div class="alert alert-danger mt-2">
              <strong>Error:</strong>
              <t t-esc="error" />
            </div>
          </t>

          <form action="/enroll/submit" method="post" class="o_portal_form"
            enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />

            <!-- STUDENT INFO -->
            <div class="card mb-4">
              <div class="card-header">
                <h4 class="mb-0">Student Information</h4>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="form-group col-md-6 mb-3">
                    <label>School Year</label>
                    <!-- Visible but not editable -->
                    <select class="form-control" disabled="True">
                      <option t-att-value="active_school_year.id">
                        <t t-esc="active_school_year.name" />
                      </option>
                    </select>
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="lrn_no">LRN No.</label>
                    <input type="text" name="lrn_no" id="lrn_no"
                      class="form-control"
                      placeholder="If no LRN yet, Type N/A" />
                  </div>
                  <div class="form-group col-md-3 mb-3">
                    <label for="first_name">First Name</label>
                    <input type="text" name="first_name" id="first_name"
                      class="form-control"
                      required="True"
                      placeholder="Enter Student's Given Name" />
                  </div>
                  <div class="form-group col-md-3 mb-3">
                    <label for="middle_name">Middle Name</label>
                    <input type="text" name="middle_name" id="middle_name"
                      class="form-control"
                      placeholder="Enter Student's Middle Name (Optional)" />
                  </div>
                  <div class="form-group col-md-3 mb-3">
                    <label for="last_name">Last Name</label>
                    <input type="text" name="last_name" id="last_name"
                      class="form-control"
                      required="True"
                      placeholder="Enter Student's Last Name" />
                  </div>
                  <div class="form-group col-md-3 mb-3">
                    <label for="ext_name">Extension Name</label>
                    <input type="text" name="ext_name" id="ext_name"
                      class="form-control"
                      placeholder="e.g. JR., III, IV, etc." />
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="birth_date">Birth Date</label>
                    <input type="date" name="birth_date" id="birth_date"
                      class="form-control"
                      required="True" />
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="psa_no">PSA No (BReN)</label>
                    <input type="text" name="psa_no" id="psa_no"
                      class="form-control"
                      placeholder="Enter Student's PSA Number" />
                  </div>
                  <div
                    class="form-group col-md-6 d-flex flex-column flex-lg-row mb-3  align-items-lg-center">
                    <label>Gender:</label>
                    <div class="d-flex flex-column flex-lg-row"
                      style="margin-left: 15px;">
                      <label class="radio-inline me-lg-3 mb-2 mb-lg-0">
                        <input type="radio" name="gender" value="male"
                          checked="True" /> Male </label>
                      <label class="radio-inline me-lg-3 mb-2 mb-lg-0">
                        <input type="radio" name="gender" value="female" /> Female </label>
                    </div>
                  </div>

                  <div class="form-group col-md-6 mb-3">
                    <label>Grade Level</label>
                    <select name="grade_level_id" class="form-control"
                      required="True">
                      <t t-foreach="grade_levels" t-as="level">
                        <option t-att-value="level.id">
                          <t t-esc="level.name" />
                        </option>
                      </t>
                    </select>
                  </div>
                  <div
                    class="form-group col-md-6 d-flex flex-column flex-lg-row  align-items-lg-center">
                    <label>Enrollment Type:</label>
                    <!-- flex-row on large screens, flex-column on md and below -->
                    <div class="d-flex flex-column flex-lg-row"
                      style="margin-left: 15px;">
                      <label class="radio-inline me-lg-3 mb-2 mb-lg-0">
                        <input type="radio" name="enrollment_type"
                          value="no_lrn" checked="True" /> No LRN </label>
                      <label class="radio-inline me-lg-3 mb-2 mb-lg-0">
                        <input type="radio" name="enrollment_type"
                          value="with_lrn" /> With LRN </label>
                      <label class="radio-inline">
                        <input type="radio" name="enrollment_type"
                          value="balik_aral" /> Returning (Balik-Aral) </label>
                    </div>
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="mother_tongue">Mother Tongue</label>
                    <input type="text" name="mother_tongue" id="mother_tongue"
                      class="form-control"
                      required="True"
                      placeholder="e.g. Tagalog, type N/A if None." />
                  </div>
                  <div
                    class="form-group col-md-4 d-flex flex-column flex-lg-row mb-3  align-items-lg-center">
                    <label> Belonging to any Indigenous Peoples (IP) Community?</label>
                    <div class="d-flex flex-column flex-lg-row"
                      style="margin-left: 15px;">
                      <label class="me-lg-3 mb-2 mb-lg-0">
                        <input type="radio" name="is_indigenous" value="no"
                          checked="True" /> No </label>
                      <label>
                        <input type="radio" name="is_indigenous" value="yes" /> Yes </label>
                    </div>
                  </div>
                  <div class="form-group col-md-8 mb-3">
                    <label for="indigenous_group">If yes, specify</label>
                    <input type="text" name="indigenous_group"
                      id="indigenous_group"
                      class="form-control" placeholder="e.g. Aeta" />
                  </div>
                </div>
              </div>
            </div>

            <!-- VACCINATION -->
            <div class="card mb-4">
              <div class="card-header">
                <h4 class="mb-0">Vaccination Information</h4>
              </div>
              <div class="card-body">
                <div class="row">
                  <div
                    class="form-group col-md-4 d-flex flex-column flex-lg-row mb-3 align-items-lg-center">
                    <label class="mb-2 mb-lg-0" style="min-width: 130px;">Is the learner vaccinated
                      against COVID-19?</label>
                    <div class="d-flex flex-column flex-lg-row ms-lg-3">
                      <label class="radio-inline me-lg-3 mb-2 mb-lg-0">
                        <input type="radio" name="is_vaccinated" value="no"
                          checked="True" /> No </label>
                      <label class="radio-inline mb-2 mb-lg-0">
                        <input type="radio" name="is_vaccinated" value="yes" /> Yes </label>
                    </div>
                  </div>
                  <div class="form-group col-md-4 mb-3">
                    <label for="first_shot_date">First Shot Date</label>
                    <input type="date" name="first_shot_date"
                      id="first_shot_date"
                      class="form-control" />
                  </div>
                  <div class="form-group col-md-4 mb-3">
                    <label for="full_vaccination_date">Full Vaccination Date</label>
                    <input type="date" name="full_vaccination_date"
                      id="full_vaccination_date"
                      class="form-control" />
                  </div>
                </div>
              </div>
            </div>

            <!-- ADDRESS -->
            <div class="card mb-4">
              <div class="card-header">
                <h4 class="mb-0">Address Information</h4>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="form-group col-md-6 mb-3">
                    <label for="house_street">House and Street</label>
                    <input type="text" name="house_street" class="form-control"
                      id="house_street" placeholder="e.g. 123 Example St."
                      required="True" />
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="barangay">Barangay</label>
                    <input type="text" name="barangay" class="form-control"
                      id="barangay" placeholder="e.g. Barangay 123"
                      required="True" />
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="city_province">City / Municipality</label>
                    <input type="text" name="city_province" class="form-control"
                      id="city_province" placeholder="e.g. Manila City"
                      required="True" />
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="zip_code">Zip Code</label>
                    <input type="text" name="zip_code" class="form-control"
                      id="zip_code" placeholder="e.g. 1234"
                      required="True" />
                  </div>
                </div>
              </div>
            </div>
            <!-- PARENT/GUARDIAN -->
            <div class="card mb-4">
              <div class="card-header">
                <h4 class="mb-0">Parent / Guardian Information</h4>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="form-group col-md-4 mb-3">
                    <label for="father_full_name">Father's Name</label>
                    <input type="text" name="father_full_name"
                      id="father_full_name" placeholder="Last Name, Given Name, Middle Name"
                      class="form-control" required="True" />
                  </div>
                  <div class="form-group col-md-4 mb-3">
                    <label for="mother_full_name">Mother's Name</label>
                    <input type="text" name="mother_full_name"
                      id="mother_full_name" placeholder="Last Name, Given Name, Middle Name"
                      class="form-control" required="True" />
                  </div>
                  <div class="form-group col-md-4 mb-3">
                    <label for="guardian_full_name">Guardian's Full Name</label>
                    <input type="text" name="guardian_full_name"
                      id="guardian_full_name" placeholder="Last Name, Given Name, Middle Name"
                      class="form-control" />
                  </div>
                  <div class="form-group col-md-4 mb-3">
                    <label for="home_phone">Home Phone</label>
                    <input type="text" name="home_phone" id="home_phone"
                      placeholder="e.g. +1234567890"
                      class="form-control" />
                  </div>
                  <div class="form-group col-md-4 mb-3">
                    <label for="office_phone">Office Phone</label>
                    <input type="text" name="office_phone" id="office_phone"
                      placeholder="e.g. +1234567890"
                      class="form-control" />
                  </div>
                  <div class="form-group col-md-4 mb-3">
                    <label for="user_mobile">Mobile Phone</label>
                    <input type="text" name="user_mobile" id="user_mobile"
                      placeholder="e.g. +1234567890"
                      class="form-control" />
                  </div>
                </div>
              </div>
            </div>

            <!-- RETURNING LEARNERS -->
            <div class="card mb-4">
              <div class="card-header">
                <h4 class="mb-0">Returning Learners / Transferees</h4>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="form-group col-md-6 mb-3">
                    <label for="last_school_name">Previous School Name</label>
                    <input type="text" name="last_school_name"
                      id="last_school_name"
                      class="form-control" />
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="last_school_id">School ID</label>
                    <input type="text" name="last_school_id" id="last_school_id"
                      class="form-control" />
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label for="last_school_address">School Address</label>
                    <input type="text" name="last_school_address"
                      id="last_school_address"
                      class="form-control" />
                  </div>
                  <div class="form-group col-md-6 mb-3">
                    <label>Last Grade Level</label>
                    <select name="last_grade_level_id" class="form-control">
                      <option value="">--</option>
                      <t t-foreach="grade_levels" t-as="lvl">
                        <option t-att-value="lvl.id">
                          <t t-esc="lvl.name" />
                        </option>
                      </t>
                    </select>
                  </div>
                  <div class="form-group col-md-3 mb-3">
                    <label>Last School Year</label>
                    <select name="last_school_year_id" class="form-control">
                      <option value="">--</option>
                      <t t-foreach="school_years" t-as="sy">
                        <option t-att-value="sy.id">
                          <t t-esc="sy.name" />
                        </option>
                      </t>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <!-- PAYMENT AND CONSENT -->
            <div class="card mb-4">
              <div class="card-header">
                <h4 class="mb-0">Payment and Consent</h4>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="form-group col-md-6 mb-3">
                    <label>Payment Term</label>
                    <select name="tuition_id" class="form-control"
                      required="True">
                      <option value="">--</option>
                      <t t-foreach="payment_plans" t-as="term">
                        <option t-att-value="term.id">
                          <t t-esc="term.name" />
                        </option>
                      </t>
                    </select>
                  </div>
                  <div class="form-group col-md-6 d-flex align-items-end mb-3">
                    <div class="form-check">
                      <input type="checkbox" class="form-check-input"
                        name="agreed" required="True" />
                      <label class="form-check-label">I hereby certify that
                        the above information given
                        are true and correct to the best of my knowledge and
                        I allow the Department of
                        Education to use my child’s details to create and/or
                        update his/her learner
                        profile in the School Information System. The
                        information herein shall be
                        treated
                        as confidential in compliance with the Data Privacy
                        Act of 2012.</label>
                    </div>
                  </div>
                </div>

              </div>
            </div>

            <!-- SUBMIT BUTTON -->
            <div class="text-end">
              <button type="submit" class="btn btn-primary">Submit Enrollment</button>
            </div>
          </form>
        </div>
      </t>
    </template>

    <template id="website_enroll_thanks" name="Enrollment Thank You">
      <t t-call="website.layout">
        <div class="container my-5">
          <div class="text-center">
            <h1 class="mb-4">Thank You!</h1>
            <p class="lead">Your enrollment has been submitted successfully. We will
              contact you for
              the next steps.</p>
            <a href="/" class="btn btn-success mt-3">Back to Home</a>
          </div>
        </div>
      </t>
    </template>
  </data>
</odoo>