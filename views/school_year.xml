<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="sis_school_year_list" model="ir.ui.view">
            <field name="name">School Year List</field>
            <field name="model">sis.school.year</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="date_start" />
                    <field name="date_end" />
                    <field name="state" />
                    <field name="company_id" />
                    <field name="previous_school_year_id" optional="hide" />
                    <field name="section_count" optional="hide"/>
                    <field name="period_count" optional="hide"/>
                    <field name="tuition_count" optional="hide"/>
                    <field name="enrollment_count" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="sis_school_year_form" model="ir.ui.view">
            <field name="name">School Year Form</field>
            <field name="model">sis.school.year</field>
            <field name="arch" type="xml">
                <form string="School Year">
                    <header>
                        <button name="action_open_initialize_wizard" type="object" string="Initialize from Previous Year" class="btn-secondary" invisible="state == 'closed'" />
                        <button name="action_set_active" type="object" string="Set Active" class="btn-primary" invisible="state == 'active'" />
                        <button name="action_close_school_year" type="object" string="Close School Year" invisible="state == 'closed'" confirm="Closing a school year should only be done once rollover and year-end tasks are complete."/>
                        <button name="action_set_draft" type="object" string="Set Draft" invisible="state == 'draft'" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,closed" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_enrollments" class="oe_stat_button" icon="fa-users">
                                <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                            </button>
                            <button type="object" name="action_view_sections" class="oe_stat_button" icon="fa-sitemap">
                                <field name="section_count" widget="statinfo" string="Sections"/>
                            </button>
                            <button type="object" name="action_view_periods" class="oe_stat_button" icon="fa-calendar">
                                <field name="period_count" widget="statinfo" string="Periods"/>
                            </button>
                            <button type="object" name="action_view_tuitions" class="oe_stat_button" icon="fa-money">
                                <field name="tuition_count" widget="statinfo" string="Tuitions"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="company_id" />
                                <field name="previous_school_year_id" domain="[('company_id', '=', company_id)]" />
                            </group>
                            <group>
                                <field name="date_start" />
                                <field name="date_end" />
                                <field name="state" />
                            </group>
                        </group>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <record id="sis_school_year_search" model="ir.ui.view">
            <field name="name">School Year Search</field>
            <field name="model">sis.school.year</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="company_id" />
                    <field name="state" />
                    <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]" />
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]" />
                    <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]" />
                    <group expand="0" string="Group By">
                        <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" />
                        <filter name="group_state" string="State" context="{'group_by': 'state'}" />
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
